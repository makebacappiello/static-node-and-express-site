extends layout.pug

block content

  nav.nav
    a(href='/')
      span &larr;
      |  Back

  article.portfolio-projects
    .inner-wrapper.flex-row-wrap.two-col
      .project-info-box.box

        //- The project Title using interpolation
        h1 #{project.project_name}

        //- The project description using interpolation
        p #{project.description}

      .project-tech-links-box.box
        h6 Technologies
        ul

          //- Loop over this project's technologies array
          each tech in project.technologies

            //- One list item for each technology
            li= tech

        //- Link to the live site (target _blank opens it in a new tab)
        a.btn-link(href=project.live_link, target='_blank') Live Demo

        //- Link to the GitHub repo (also opens in a new tab)
        a.btn-link(href=project.github_link, target='_blank') GitHub Repo

    .project-img-box.box

      //- Looping over images, skipping the first one (that's the home page thumbnail)
      each image in project.image_urls.slice(1)

        //- Show each image, with alt text built from the project name
        img.project-img(src=image, alt=`Screenshot of ${project.project_name}`)


    nav.nav
      a(href='/')
        span &larr;
        |  Back
