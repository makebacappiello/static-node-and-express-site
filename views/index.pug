//- Use the shared layout (header, footer, CSS) for this page
extends layout.pug

//- Everything below goes into the layout's content area
block content

  article.portfolio-intro

    //- The welcome message
    h1 Hello, Potential Employers

    //- Description paragraph
    p Welcome to my portfolio. Here I will share with you the projects I've built while learning web development.

  article.portfolio-project-thumbs
    .projects-box.box.grid

      //- Loop over each project from projects array we passed in from app.js
      each project in projects

        //- One box on the page for each project
        .cell

          //- Link to this project's page, like /project/0
          a(href=`/project/${project.id}`)

            //- Show the first image, with alt text received from the project name
            img.thumbnail(src=project.image_urls[0], alt=`Thumbnail of ${project.project_name}`)

            //- Show the project name under the image
            h5= project.project_name